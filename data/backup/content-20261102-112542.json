      "steps": [
       {
        "t": "基准集",
        "short": "基准集",
        "sum": "先准备一份固定考卷",
        "goal": "让每一轮结果都在同一把尺子下比较，否则分数涨跌说明不了问题。",
        "how": "按任务类型 × 画风 × 难度分层，建立 100–200 条用例，训练集和留出集分开。",
        "out": "分层用例库。留出集不参与改规则，只用于发版前的回归检查。"
       },
       {
        "t": "A/B 生成",
        "short": "A/B 生成",
        "sum": "用同一批任务生成两组图",
        "goal": "在相同条件下比较原始提示词和润色提示词，排除 seed 运气。",
        "how": "两版共用同一组原始任务命令，每条跑 4 个 seed，并在多个模型上各跑一遍。",
        "out": "成组的对比图。按 200 条用例、2 个模型计算，一轮约 3200 张。"
       },
       {
        "t": "AI 盲评 + 人工抽检",
        "short": "盲评抽检",
        "human": true,
        "sum": "AI 打分，人工核验",
        "goal": "给每组对比一个可信的胜负结果，这是后面所有判断的依据。",
        "how": "编辑任务看指令执行度、非编辑区保持、一致性、瑕疵；生图任务看语义还原、构图、色彩光影、风格、可用度。逐维度判 A 好、B 好或平，并交换左右顺序再评一次。",
        "out": "每组的胜负结果和评分准确率。人工发现评分不准的组，会重新打分。"
       },
       {
        "t": "差异归因",
        "short": "差异归因",
        "sum": "解释润色版为什么赢或输",
        "goal": "把一次次对比结果，变成下一轮可以验证的规则假设。",
        "how": "把提示词差异、两张图和评分差交给 AI 分析。Good Case 和 Bad Case 都要写，输出必须是带适用范围的规则卡，不写散文。",
        "out": "候选规则卡。此时它只是假设，不能直接进入 Skill。"
       },
       {
        "t": "人工审假设",
        "short": "人工审核",
        "human": true,
        "sum": "人判断这条规则说得通吗",
        "goal": "拦下 AI 编出来的“合理解释”，这是最容易出错的环节之一。",
        "how": "分对、错、存疑三档。判对和存疑的规则都送去验证，判错的存为反例。",
        "out": "待验证的规则清单，以及用来训练 AI 评委的反例。"
       },
       {
        "t": "消融验证",
        "short": "消融验证",
        "sum": "单独开关一条规则，看它是否真的有用",
        "goal": "证明效果来自这条规则，而不是其他因素。消融就是把规则去掉再比较。",
        "how": "每条候选规则在至少 20 条同场景用例上做开 / 关对照。",
        "out": "胜率提升超过 10 个百分点，才算“已验证”的规则。"
       },
       {
        "t": "编译 + 回归门禁",
        "short": "编译发版",
        "sum": "合格的新版本才能发布",
        "goal": "防止 Skill 越改越乱，也防止只对训练用例有效的过拟合。",
        "how": "按“模型 × 任务”挑选生效规则，由脚本编译成 Skill，不手改；每个组合最多 15–20 条规则。",
        "out": "留出集胜率不降才发版，降了就回滚。新版本带版本号，进入下一轮。"
       }
